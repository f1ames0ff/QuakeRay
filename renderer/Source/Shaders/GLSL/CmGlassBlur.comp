#version 460

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"
#include "GlassBlur.inl"
#include "GlassDenoise.inl"

layout(push_constant) uniform GlassBlurDirection
{
    uint axis;
} glassBlurDirection;

layout(local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1) in;

void main()
{
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(globalUniform.renderWidth) || pix.y >= int(globalUniform.renderHeight))
    {
        return;
    }
    const vec4 glass = texelFetch(framebufQ2GlassFilter_Sampled, getCheckerboardPix(pix), 0);
    const uint axis = glassBlurDirection.axis;
    if (globalUniform.glassBlur == 0u)
    {
        if (!isRtGlass(glass))
        {
            return;
        }
        if (axis == 0u)
        {
            const vec4 color = accumulateGlass(pix, glass);
            imageStore(framebufQ2GlassHistory, pix, color);
            imageStore(framebufPreFinal, pix, vec4(color.rgb, 0.0));
        }
        else
        {
            imageStore(framebufBloomInput, pix, vec4(spatialGlass(pix, glass), 0.0));
        }
        return;
    }
    if (abs(glass.a) < 1.0)
    {
        return;
    }

    const vec3 color = blurGlassAxis(pix, clamp(abs(glass.a) - 1.0, 0.0, 1.0), axis);
    if (axis == 0u)
    {
        imageStore(framebufPreFinal, pix, vec4(color, 0.0));
    }
    else
    {
        const vec4 reflection = texelFetch(framebufQ2GlassReflection_Sampled, pix, 0);
        imageStore(framebufBloomInput, pix, vec4(color * glass.rgb * (1.0 - clamp(reflection.a, 0.0, 1.0)) + reflection.rgb, 0.0));
    }
}
