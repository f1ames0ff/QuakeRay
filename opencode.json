{
  "mcp": {
    "servers": {
      "quakeray": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--offline",
          "--frozen",
          "--project",
          "tools/quakeray_mcp",
          "python",
          "-B",
          "-m",
          "quakeray_mcp"
        ],
        "environment": {
          "QUAKERAY_BUILD": "build/Debug",
          "QUAKERAY_IMPORT_ROOTS": "build/Debug/ad",
          "QUAKERAY_ENABLE_JOBS": "0",
          "QUAKERAY_ENABLE_RESEARCH": "0"
        }
      }
    }
  }
}