set -eu

repo_root="$(git rev-parse --show-toplevel)"
script="$repo_root/tools/copyright_header.py"

if [ ! -f "$script" ]; then
    exit 0
fi

if command -v python3 >/dev/null 2>&1; then
    exec python3 -B "$script" --staged
elif command -v python >/dev/null 2>&1; then
    exec python -B "$script" --staged
elif command -v py >/dev/null 2>&1; then
    exec py -3 -B "$script" --staged
else
    echo "error: Python 3 is required by .githooks/pre-commit to check/add copyright headers." >&2
    exit 1
fi
